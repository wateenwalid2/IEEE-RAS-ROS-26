<?xml version="1.0"?>
<robot name="materials">

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <material name="bink">
    <color rgba="1 0.75 0.8 1"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="1" radius="0.3"/>
      </geometry>
      <material name="white"/>
    </visual>
  </link>

  <link name="right_leg">
    <visual>
      <geometry>
        <box size="0.6 0.1 0.2"/>
      </geometry>
      <origin rpy="0 1.57075 0" xyz="0 0 0"/>
      <material name="bink"/>
    </visual>
  </link>

  <joint name="base_to_right_leg" type="continuous">
    <parent link="base_link"/>
    <child link="right_leg"/>
    <origin xyz="0 -0.35 0"/>
    <axis xyz="0 1 0"/> 
  </joint>

  <link name="left_leg">
    <visual>
      <geometry>
        <box size="0.6 0.1 0.2"/>
      </geometry>
      <origin rpy="0 1.57075 0" xyz="0 0 0"/>
      <material name="bink"/>
    </visual>
  </link>

  <joint name="base_to_left_leg" type="fixed">
    <parent link="base_link"/>
    <child link="left_leg"/>
    <origin xyz="0 0.35 0"/>
  </joint>

</robot>